<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Stock Buy / Sell Calculator</title>
<style>body{font-family:Segoe UI,Arial,sans-serif;background:#f1f5f9;margin:0;padding:30px 12px;color:#172033}.card{max-width:520px;margin:auto;background:white;border-radius:16px;padding:28px;box-shadow:0 8px 30px #1e293b18}h1{margin:0 0 8px;font-size:25px}.hint{color:#64748b;font-size:14px;margin-bottom:22px}label{display:block;margin:13px 0 5px;font-weight:600;font-size:14px}input{box-sizing:border-box;width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:12px;font-size:16px}input:focus{outline:2px solid #93c5fd} .input-row{display:flex;gap:8px;align-items:center}.input-row input{flex:1;min-width:0}.individual-clears{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.individual-clears button{padding:10px 5px;font-size:12px;color:#b91c1c;border-color:#fecaca;background:#fff7f7}.buttons button{font-size:17px;padding:16px 12px}input.calculated{background:#eff6ff;border-color:#60a5fa}.buttons{display:flex;gap:10px;margin-top:22px}button{padding:12px;border-radius:9px;border:1px solid #cbd5e1;background:white;font-weight:600;cursor:pointer;flex:1}button.primary{background:#2563eb;border-color:#2563eb;color:white}#message{margin-top:15px;font-size:14px;padding:12px;border-radius:8px;display:none}.error{background:#fef2f2;color:#991b1b}.success{background:#ecfdf5;color:#065f46}.foot{font-size:12px;color:#64748b;line-height:1.5;margin-top:18px}</style></head>
<body><main class="card"><h1>Stock Buy / Sell Calculator</h1><p class="hint">Enter any 3 numerical values to calculate the other 2, when mathematically possible.</p><label for="stock">Stock Name (optional)</label><input id="stock" type="text" placeholder="e.g. RELIANCE or TCS"><div id="fields"></div><div class="buttons"><button class="primary" onclick="calculate()">Calculate</button><button onclick="clearAll()">Clear All</button></div><div class="individual-clears" id="individual-clears"><button type="button" onclick="clearField('stock')">Clear Stock Name</button></div><div id="message" role="status"></div><p class="foot">Change = (Sell Price - Buy Price) x Quantity.<br>Change % = (Sell Price - Buy Price) / Buy Price x 100.<br>Change represents total profit or loss before fees and taxes. Some combinations cannot uniquely determine the missing values.</p></main>
<script>
const labels=['Buy Price','Sell Price','Quantity','Change','Change %'];
const fields=document.getElementById('fields');
labels.forEach((label,i)=>{const l=document.createElement('label');l.htmlFor='v'+i;l.textContent=label;const input=document.createElement('input');input.type='number';input.step='any';input.id='v'+i;input.placeholder='Enter '+label;input.addEventListener('input',()=>{input.classList.remove('calculated');message('')});fields.append(l,input);const clear=document.createElement('button');clear.type='button';clear.textContent='Clear '+label;clear.onclick=()=>clearField('v'+i);document.getElementById('individual-clears').append(clear)});
function clearField(id){const input=document.getElementById(id);input.value='';input.classList.remove('calculated');message('')}

function message(text,error=false){const e=document.getElementById('message');e.textContent=text;e.style.display=text?'block':'none';e.className=error?'error':'success'}
function clearAll(){document.querySelectorAll('input').forEach(e=>{e.value='';e.classList.remove('calculated')});message('')}
function calculate(){
const inputs=labels.map((_,i)=>document.getElementById('v'+i));const present=inputs.map(x=>x.value.trim()!=='');const count=present.filter(Boolean).length;
if(count!==3){message('Enter exactly 3 numerical values. Clear any previous calculated values before a new calculation.',true);return}
let [b,s,q,c,p]=inputs.map(x=>x.value.trim()===''?NaN:Number(x.value));
if(inputs.some((x,i)=>present[i]&&!Number.isFinite(Number(x.value)))){message('Enter valid finite numbers.',true);return}
const has=i=>present[i];const fail=t=>{message(t,true);return};
if(has(0)&&has(1)){
 if(has(2)){c=(s-b)*q;p=b===0?NaN:100*(s-b)/b}
 else if(has(3)){if(s===b)return fail('Quantity is not uniquely determined when the price difference is zero.');q=c/(s-b);p=b===0?NaN:100*(s-b)/b}
 else return fail('Buy Price, Sell Price and Change % cannot determine Quantity or total Change.');
}else if(has(0)&&has(2)&&has(3)){if(q===0)return fail('Quantity cannot be zero.');s=b+c/q;p=b===0?NaN:100*(s-b)/b}
else if(has(0)&&has(2)&&has(4)){s=b*(1+p/100);c=(s-b)*q}
else if(has(0)&&has(3)&&has(4)){if(p===0)return fail('Zero Change % does not uniquely determine Quantity.');s=b*(1+p/100);if(s===b)return fail('Quantity cannot be determined.');q=c/(s-b)}
else if(has(1)&&has(2)&&has(3)){if(q===0)return fail('Quantity cannot be zero.');b=s-c/q;p=b===0?NaN:100*(s-b)/b}
else if(has(1)&&has(2)&&has(4)){if(p===-100)return fail('At -100%, Sell Price must be zero and Buy Price is not uniquely determined.');b=s/(1+p/100);c=(s-b)*q}
else if(has(1)&&has(3)&&has(4)){if(p===-100||p===0)return fail('These values cannot uniquely determine Buy Price and Quantity.');b=s/(1+p/100);if(s===b)return fail('Quantity cannot be determined.');q=c/(s-b)}
else if(has(2)&&has(3)&&has(4)){if(q===0||p===0)return fail('These values cannot uniquely determine both prices.');b=100*c/(q*p);s=b+c/q}
else return fail('These three values cannot determine both missing values.');
const results=[b,s,q,c,p];if(results.some(x=>!Number.isFinite(x)))return fail('The missing values are undefined for these inputs.');
if(b<0||s<0||q<=0)return fail('The calculated result requires nonnegative prices and positive Quantity. Check the inputs.');
results.forEach((value,i)=>{if(!present[i]){inputs[i].value=String(Number(value.toFixed(8)));inputs[i].classList.add('calculated')}});
message('Calculated the two missing values. Highlighted fields are results.');
}
</script></body></html>
